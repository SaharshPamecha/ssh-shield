# Addresses CIS Benchmark requirements for secure SSH configuration.

set -euo pipefail

VERSION="1.0.0"
SSHD_CONFIG="/etc/ssh/sshd_config"
REPORT_DIR="/tmp/ssh-shield-reports"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check if running as root (needed for enforce)
check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}✗ Error: This operation requires root privileges${NC}"
        echo -e "${YELLOW}→ Run with: sudo ssh-shield $1${NC}"
        exit 1
    fi
}

# Check if sshd_config exists
check_config() {
    if [[ ! -f "$SSHD_CONFIG" ]]; then
        echo -e "${RED}✗ Error: $SSHD_CONFIG not found${NC}"
        exit 1
    fi
}

# Get current setting value
get_setting() {
    local setting="$1"
    local value=$(grep -E "^${setting}" "$SSHD_CONFIG" 2>/dev/null | awk '{print $2}' | head -1)
    
    if [[ -z "$value" ]]; then
        # Check if it's commented out (default behavior)
        if grep -E "^#${setting}" "$SSHD_CONFIG" &>/dev/null; then
            echo "default"
        else
            echo "not_set"
        fi
    else
        echo "$value"
    fi
}

# Print status with color
print_status() {
    local setting="$1"
    local value="$2"
    local secure_value="$3"
    local description="$4"
    
    if [[ "$value" == "$secure_value" ]]; then
        echo -e "  ${GREEN}✓${NC} ${setting}: ${GREEN}${value}${NC}"
        echo -e "    ${description}"
    elif [[ "$value" == "default" || "$value" == "not_set" ]]; then
        echo -e "  ${YELLOW}!${NC} ${setting}: ${YELLOW}${value}${NC} (using OpenSSH default)"
        echo -e "    ${description}"
    else
        echo -e "  ${RED}✗${NC} ${setting}: ${RED}${value}${NC}"
        echo -e "    ${description}"
    fi
}

# Audit command
audit() {
    check_config
    
    echo ""
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}  SSH-SHIELD AUDIT REPORT${NC}"
    echo -e "${CYAN}  $(date '+%Y-%m-%d %H:%M:%S')${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    # Server info
    echo -e "${BLUE}Server:${NC} $(hostname)"
    echo -e "${BLUE}OS:${NC} $(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d'"' -f2 || echo 'Unknown')"
    echo -e "${BLUE}SSH Config:${NC} $SSHD_CONFIG"
    echo ""
    
    echo -e "${CYAN}┌─ Authentication Settings ───────────────────────────────────┐${NC}"
    
    # PermitRootLogin
    root_login=$(get_setting "PermitRootLogin")
    print_status "PermitRootLogin" "$root_login" "no" "${YELLOW}CIS 5.2.8: Disabling root login prevents brute-force attacks${NC}"
    
    # PasswordAuthentication
    pass_auth=$(get_setting "PasswordAuthentication")
    print_status "PasswordAuthentication" "$pass_auth" "no" "${YELLOW}CIS 5.2.12: Key-based auth is more secure than passwords${NC}"
    
    # PubkeyAuthentication
    key_auth=$(get_setting "PubkeyAuthentication")
    print_status "PubkeyAuthentication" "$key_auth" "yes" "${YELLOW}Required for key-based authentication${NC}"
    
    echo -e "${CYAN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    
    echo -e "${CYAN}┌─ Protocol & Connection Settings ──────────────────────────┐${NC}"
    
    # Protocol
    protocol=$(get_setting "Protocol")
    print_status "Protocol" "$protocol" "2" "${YELLOW}SSH v2 only (v1 has known vulnerabilities)${NC}"
    
    # PermitEmptyPasswords
    empty_pass=$(get_setting "PermitEmptyPasswords")
    print_status "PermitEmptyPasswords" "$empty_pass" "no" "${YELLOW}CIS 5.2.7: Empty passwords are a critical risk${NC}"
    
    # MaxAuthTries
    max_tries=$(get_setting "MaxAuthTries")
    if [[ "$max_tries" == "default" || "$max_tries" == "not_set" || "$max_tries" -le 4 ]]; then
        echo -e "  ${GREEN}✓${NC} MaxAuthTries: ${GREEN}${max_tries}${NC}"
    else
        echo -e "  ${YELLOW}!${NC} MaxAuthTries: ${YELLOW}${max_tries}${NC}"
    fi
    echo -e "    ${YELLOW}CIS 5.2.5: Limit brute-force attempts${NC}"
    
    # ClientAliveInterval
    alive_int=$(get_setting "ClientAliveInterval")
    if [[ "$alive_int" == "default" || "$alive_int" == "not_set" || "$alive_int" -le 300 ]]; then
        echo -e "  ${GREEN}✓${NC} ClientAliveInterval: ${GREEN}${alive_int}${NC}"
    else
        echo -e "  ${YELLOW}!${NC} ClientAliveInterval: ${YELLOW}${alive_int}${NC}"
    fi
    echo -e "    ${YELLOW}Timeout idle connections (300s or less recommended)${NC}"
    
    echo -e "${CYAN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    
    # Overall score
    local score=0
    local total=6
    
    [[ "$root_login" == "no" ]] && ((score++))
    [[ "$pass_auth" == "no" ]] && ((score++))
    [[ "$key_auth" == "yes" || "$key_auth" == "default" ]] && ((score++))
    [[ "$protocol" == "2" || "$protocol" == "default" ]] && ((score++))
    [[ "$empty_pass" == "no" || "$empty_pass" == "default" ]] && ((score++))
    [[ "$max_tries" != "not_set" && "$max_tries" -le 6 ]] && ((score++))
    
    echo -e "${CYAN}┌─ Security Score ────────────────────────────────────────────┐${NC}"
    echo ""
    if [[ $score -eq $total ]]; then
        echo -e "  ${GREEN}★★★★★${NC} ${GREEN}${score}/${total}${NC} - Fully CIS Compliant"
    elif [[ $score -ge 4 ]]; then
        echo -e "  ${YELLOW}★★★★☆${NC} ${YELLOW}${score}/${total}${NC} - Mostly Secure (minor improvements needed)"
    else
        echo -e "  ${RED}★★☆☆☆${NC} ${RED}${score}/${total}${NC} - Needs Hardening"
    fi
    echo ""
    echo -e "${CYAN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
    
    return 0
}

# Harden command - apply secure settings
harden() {
    check_config
    check_root
    
    echo ""
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}  SSH-SHIELD HARDENING${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    # Create backup
    local backup_file="${SSHD_CONFIG}.backup.$(date +%Y%m%d_%H%M%S)"
    cp "$SSHD_CONFIG" "$backup_file"
    echo -e "${BLUE}→ Created backup:${NC} $backup_file"
    echo ""
    
    # Apply hardening
    echo -e "${CYAN}Applying CIS-compliant hardening...${NC}"
    echo ""
    
    # 1. Disable root login
    if grep -E "^#?PermitRootLogin" "$SSHD_CONFIG" &>/dev/null; then
        sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' "$SSHD_CONFIG"
    else
        echo "PermitRootLogin no" >> "$SSHD_CONFIG"
    fi
    echo -e "  ${GREEN}✓${NC} PermitRootLogin set to no"
    
    # 2. Disable password authentication (optional - confirm first)
    echo ""
    echo -e "${YELLOW}⚠ Warning: Disabling PasswordAuthentication will require key-based auth.${NC}"
    echo -e "${YELLOW}  Ensure you have SSH keys configured before proceeding.${NC}"
    echo ""
    read -p "Disable password authentication? (y/N): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        if grep -E "^#?PasswordAuthentication" "$SSHD_CONFIG" &>/dev/null; then
            sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' "$SSHD_CONFIG"
        else
            echo "PasswordAuthentication no" >> "$SSHD_CONFIG"
        fi
        echo -e "  ${GREEN}✓${NC} PasswordAuthentication set to no"
    else
        echo -e "  ${YELLOW}!${NC} PasswordAuthentication unchanged"
    fi
    
    # 3. Ensure Protocol 2
    if ! grep -E "^Protocol 2" "$SSHD_CONFIG" &>/dev/null; then
        echo "Protocol 2" >> "$SSHD_CONFIG"
        echo -e "  ${GREEN}✓${NC} Protocol 2 enforced"
    fi
    
    # 4. Disable empty passwords
    if grep -E "^#?PermitEmptyPasswords" "$SSHD_CONFIG" &>/dev/null; then
        sed -i 's/^#\?PermitEmptyPasswords.*/PermitEmptyPasswords no/' "$SSHD_CONFIG"
    else
        echo "PermitEmptyPasswords no" >> "$SSHD_CONFIG"
    fi
    echo -e "  ${GREEN}✓${NC} PermitEmptyPasswords set to no"
    
    # 5. Set reasonable MaxAuthTries
    if grep -E "^#?MaxAuthTries" "$SSHD_CONFIG" &>/dev/null; then
        sed -i 's/^#\?MaxAuthTries.*/MaxAuthTries 3/' "$SSHD_CONFIG"
    else
        echo "MaxAuthTries 3" >> "$SSHD_CONFIG"
    fi
    echo -e "  ${GREEN}✓${NC} MaxAuthTries set to 3"
    
    # 6. Set connection timeout
    if grep -E "^#?ClientAliveInterval" "$SSHD_CONFIG" &>/dev/null; then
        sed -i 's/^#\?ClientAliveInterval.*/ClientAliveInterval 300/' "$SSHD_CONFIG"
    else
        echo "ClientAliveInterval 300" >> "$SSHD_CONFIG"
    fi
    echo -e "  ${GREEN}✓${NC} ClientAliveInterval set to 300s"
    
    if grep -E "^#?ClientAliveCountMax" "$SSHD_CONFIG" &>/dev/null; then
        sed -i 's/^#\?ClientAliveCountMax.*/ClientAliveCountMax 2/' "$SSHD_CONFIG"
    else
        echo "ClientAliveCountMax 2" >> "$SSHD_CONFIG"
    fi
    echo -e "  ${GREEN}✓${NC} ClientAliveCountMax set to 2"
    
    echo ""
    echo -e "${CYAN}┌─ Validation ────────────────────────────────────────────────┐${NC}"
    echo ""
    
    # Validate SSH config
    if sshd -t 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} SSH configuration is valid"
        
        # Restart SSH service
        if systemctl restart sshd 2>/dev/null || service ssh restart 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} SSH service restarted successfully"
            echo ""
            echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
            echo -e "${GREEN}  HARDENING COMPLETE${NC}"
            echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
            echo ""
            echo -e "${YELLOW}IMPORTANT:${NC} Do not close this session until you verify"
            echo -e "           you can still connect in a new terminal!"
            echo ""
        else
            echo -e "  ${RED}✗ Error: Failed to restart SSH service${NC}"
            echo -e "  ${YELLOW}→ Backup available at: $backup_file${NC}"
            exit 1
        fi
    else
        echo -e "  ${RED}✗ Error: SSH configuration is invalid!${NC}"
        echo -e "  ${YELLOW}→ Restoring from backup...${NC}"
        cp "$backup_file" "$SSHD_CONFIG"
        echo -e "  ${GREEN}✓${NC} Original configuration restored"
        exit 1
    fi
    
    echo -e "${CYAN}└─────────────────────────────────────────────────────────────┘${NC}"
    echo ""
}

# Generate HTML report
report() {
    check_config
    
    mkdir -p "$REPORT_DIR"
    local report_file="${REPORT_DIR}/ssh-shield-report-$(date +%Y%m%d-%H%M%S).html"
    local hostname=$(hostname)
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Get current values
    root_login=$(get_setting "PermitRootLogin")
    pass_auth=$(get_setting "PasswordAuthentication")
    key_auth=$(get_setting "PubkeyAuthentication")
    protocol=$(get_setting "Protocol")
    empty_pass=$(get_setting "PermitEmptyPasswords")
    max_tries=$(get_setting "MaxAuthTries")
    
    # Calculate score
    local score=0
    local total=6
    [[ "$root_login" == "no" ]] && ((score++))
    [[ "$pass_auth" == "no" ]] && ((score++))
    [[ "$key_auth" == "yes" || "$key_auth" == "default" ]] && ((score++))
    [[ "$protocol" == "2" || "$protocol" == "default" ]] && ((score++))
    [[ "$empty_pass" == "no" || "$empty_pass" == "default" ]] && ((score++))
    [[ "$max_tries" != "not_set" && "$max_tries" -le 6 ]] && ((score++))
    
    # Determine grade
    if [[ $score -eq $total ]]; then
        grade="A+"
        grade_color="#10b981"
        status="Fully Compliant"
    elif [[ $score -ge 4 ]]; then
        grade="B"
        grade_color="#f59e0b"
        status="Mostly Secure"
    else
        grade="D"
        grade_color="#ef4444"
        status="Needs Hardening"
    fi
    
    cat > "$report_file" << EOF
