    echo -e "${BLUE}EXAMPLES:${NC}"
    echo "  # Check current status"
    echo "  ssh-shield audit"
    echo ""
    echo "  # Apply hardening (requires root)"
    echo "  sudo ssh-shield harden"
    echo ""
    echo "  # Generate report"
    echo "  ssh-shield report"
    echo ""
    echo -e "${BLUE}SECURITY:${NC}"
    echo "  • audit:   Safe, read-only operation"
    echo "  • report:  Safe, read-only operation"
    echo "  • harden:  Requires root. Creates backup automatically."
    echo "             Validates config before restarting SSH."
    echo ""
    echo -e "${CYAN}Day 3 of 100 Days of DevOps${NC}"
    echo -e "${CYAN}Built by Saharsh Pamecha • MIT License${NC}"
    echo ""
}

# Main
case "${1:-help}" in
    audit)
        audit
        ;;
    harden)
        harden
        ;;
    report)
        report
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}✗ Unknown command: $1${NC}"
        show_help
        exit 1
        ;;
esac
